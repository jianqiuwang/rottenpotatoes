<h1>Edit Movie</h1>

<%= form_with model: @movie, local: true do |form| %>
  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :rating %>
    <%= form.select :rating, ['G', 'PG', 'PG-13', 'R', 'NC-17'] %>
  </div>

  <div>
    <%= form.label :description %>
    <%= form.text_area :description %>
  </div>

  <div>
    <%= form.label :release_date %>
    <%= form.date_field :release_date %>
  </div>

  <%= form.submit "Update Movie" %>
<% end %>

<%= link_to "Back to Movies", movies_path %>